{
  "name": "clinic-stock",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.16",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning jest",
    "test:db": "NODE_OPTIONS=--disable-warning=ExperimentalWarning jest --selectProjects db",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning jest --watch",
    "typecheck": "tsc --noEmit",
    "schema:dump": "NODE_OPTIONS=--disable-warning=ExperimentalWarning node scripts/dump-schema.ts > docs/schema.sql",
    "backlog:jira": "NODE_OPTIONS=--disable-warning=ExperimentalWarning node scripts/backlog-jira.ts > jira/backlog.csv",
    "eas:setup": "npx --yes eas-cli@23.2.0 init && npx --yes eas-cli@23.2.0 update:configure",
    "build:apk": "npx --yes eas-cli@23.2.0 build --platform android --profile production",
    "build:preview": "npx --yes eas-cli@23.2.0 build --platform android --profile preview",
    "ota": "npx --yes eas-cli@23.2.0 update --branch production --message",
    "keystore": "npx --yes eas-cli@23.2.0 credentials"
  },
  "private": true
}
