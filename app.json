{
  "expo": {
    "name": "Vialbook",
    "slug": "clinic-stock",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clinicstock",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.clinicstock.app",
      "allowBackup": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1567dab3-8f15-46ff-8921-c3027f29bad9"
      }
    },
    "owner": "ylad1",
    "updates": {
      "url": "https://u.expo.dev/1567dab3-8f15-46ff-8921-c3027f29bad9"
    }
  }
}
